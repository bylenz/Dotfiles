// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "provider": "copilot"
  },
  "cli_default_open_behavior": "existing_window",
  "icon_theme": "Catppuccin Mocha",
  "terminal": {
    "env": {},
    "font_family": "CaskaydiaCove Nerd Font Mono"
  },
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "cursor_blink": true,
  "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
  "soft_wrap": "bounded",
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 200
  },
  "vertical_scroll_margin": 5,
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard",
  },

  // ── Lenguajes (equivalente a Mason + nvim-lspconfig) ──────────────
  // Rust, TS/JS (vtsls), ESLint, Tailwind, CSS, JSON y Python (basedpyright
  // + ruff) vienen integrados. Lua, Angular, TOML y HTML son extensiones.
  "auto_install_extensions": {
    "lua": true,
    "angular": true,
    "toml": true,
    "html": true
  },

  // ── Formateo (equivalente a conform.nvim) ─────────────────────────
  "format_on_save": "on",
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "formatter": { "language_server": { "name": "ruff" } }
    },
    "Lua": {
      "formatter": {
        "external": {
          "command": "/Users/lenz/.local/share/nvim/mason/bin/stylua",
          "arguments": ["--stdin-filepath", "{buffer_path}", "-"]
        }
      }
    },
    "TypeScript": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."],
      "formatter": "prettier"
    },
    "TSX": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."],
      "formatter": "prettier"
    },
    "JavaScript": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."],
      "formatter": "prettier"
    },
    "HTML": { "formatter": "prettier" },
    "CSS": { "formatter": "prettier" },
    "JSON": { "formatter": "prettier" }
  },

  // ── REPL / Jupyter ────────────────────────────────────────────────
  "jupyter": {
    "enabled": true
  }
}
